{
  "manifest_version": 3,
  "name": "YouTube Tidy",
  "version": "0.1.0",
  "description": "Denser homepage grid, no Shorts/Playables/topic shelves, auto-skip creator sponsor segments.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "css": [
        "src/tidy.css"
      ],
      "js": [
        "src/settings.js",
        "src/tidy.js",
        "src/sponsors.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
